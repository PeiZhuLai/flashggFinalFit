getenv                = True
request_memory        = 4000
request_cpus          = 1
+JobFlavour           = "tomorrow"
batch_name            = Bias_HighStat
environment           = "NTOYS_PER_CHUNK=1000"

on_exit_hold          = (ExitBySignal == True) || (ExitCode != 0)
periodic_release      = (NumJobStarts < 3) && ((CurrentTime - EnteredCurrentStatus) > 600)

